{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ad27c69f849db0d1d354ce488d0b3ae6",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "watch.cornerstonecoatings.com", "custom_domain": true }
  ],
  "vars": {
    "WATCH_KEY": "a68596aee3429a00eea168ccc408af7f00235119bfce7e07152f92013cecc164",
    "RIVESTREAM_PROXY": ""
  },
  "kv_namespaces": [
    {
      "binding": "RIVESTREAM_SESSION",
      "id": "004d17dd5922456c81faf58e87af6313",
      "preview_id": "5879db9d70dd420a8434871229438920"
    }
  ],
  "stream": { "binding": "STREAM" },
  "secrets_store_secrets": [
    {
      "binding": "WATCH_PUBLIC_KEY",
      "secret_name": "WATCH_PUBLIC_KEY",
      "store_id": "0837aceaf29e426aa377a4728cc6db7a"
    },
    {
      "binding": "WATCH_PRIVATE_KEY",
      "secret_name": "WATCH_PRIVATE_KEY",
      "store_id": "0837aceaf29e426aa377a4728cc6db7a"
    },
    {
      "binding": "WATCH_TMDB_API_KEY",
      "secret_name": "WATCH_TMDB_API_KEY",
      "store_id": "0837aceaf29e426aa377a4728cc6db7a"
    },
    {
      "binding": "WATCH_TMDB_API_READ_ACCESS_TOKEN",
      "secret_name": "WATCH_TMDB_API_READ_ACCESS_TOKEN",
      "store_id": "0837aceaf29e426aa377a4728cc6db7a"
    }
  ],
  "d1_databases": [
    {
      "binding": "watch",
      "database_name": "watch",
      "database_id": "2d26cd1f-e8e9-41fc-a17f-e36106702537",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "watch_bucket",
      "bucket_name": "watch"
    }
  ],
  "browser": { "binding": "BROWSER" }
}
