# Roku app build config
# Copy to .env and fill in your values (must match the worker secrets)

WATCH_PUBLIC_KEY=your-public-key-id-here
WATCH_PRIVATE_KEY=your-private-secret-here

# Sideload target (./build.sh --install)
ROKU_HOST=10.0.0.115
ROKU_DEV_USER=rokudev
ROKU_DEV_PASSWORD=dev-mode-password-here
