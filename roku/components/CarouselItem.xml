<?xml version="1.0" encoding="UTF-8"?>
<component name="CarouselItem" extends="Group" init="InitCarouselItem">
  <children>
    <Poster
      id="poster"
      width="108"
      height="162"
      loadDisplayMode="scaleToFit"
    />
    <Rectangle
      id="focusRing"
      width="116"
      height="170"
      translation="[-4, -4]"
      color="0xE5091400"
    />
    <Rectangle
      id="focusBorder"
      width="116"
      height="170"
      translation="[-4, -4]"
      color="0xE50914FF"
    >
      <Rectangle
        width="108"
        height="162"
        translation="[4, 4]"
        color="0x0E0E1000"
      />
    </Rectangle>
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="OnContentChange" />
    <field id="itemHasFocus" type="boolean" onChange="OnFocusChange" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/CarouselItem.brs" />
</component>