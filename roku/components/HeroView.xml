<?xml version="1.0" encoding="UTF-8"?>
<component name="HeroView" extends="Group">
  <interface>
    <field id="itemContent" type="node" />
  </interface>
  <children>
    <Poster
      id="backdrop"
      width="1920"
      height="1080"
      loadDisplayMode="scaleToZoom"
    />
    <Rectangle
      id="scrim"
      width="1920"
      height="1080"
    >
      <Rectangle
        id="fadeGradient"
        width="1920"
        height="600"
        translation="[0, 480]"
        color="0x00000000"
      />
    </Rectangle>
    <Label
      id="title"
      translation="[80, 720]"
      width="1200"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFFFF"
    />
    <Label
      id="meta"
      translation="[80, 820]"
      width="1200"
      font="font:MediumSystemFont"
      color="0xDDDDDDFF"
    />
    <Label
      id="overview"
      translation="[80, 880]"
      width="900"
      font="font:SmallSystemFont"
      wrap="true"
      numLines="4"
      color="0xE0E0E0FF"
    />
    <Button
      id="playBtn"
      translation="[80, 960]"
      width="280"
      height="72"
      text="Play"
    >
      <Rectangle id="bg" width="280" height="72" color="0xE50914FF" />
      <Label
        id="text"
        translation="[0, 18]"
        width="280"
        font="font:MediumBoldSystemFont"
        text="Play"
        color="0xFFFFFFFF"
        horizAlign="center"
      />
    </Button>
  </children>
  <script type="text/brightscript" uri="pkg:/components/HeroView.brs" />
</component>