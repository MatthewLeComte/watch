<?xml version="1.0" encoding="UTF-8"?>
<component name="ResolveView" extends="Group">
  <interface>
    <field id="sourceId" type="string" />         ' e.g., "rivestream:movie:27205"
    <field id="resolved" type="node" />           ' Result ContentNode with hlsUrl, cookieHeader, etc.
    <field id="hasError" type="bool" />
    <field id="errorMessage" type="string" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="0x0E0E10FF" />
    <Rectangle id="loading" width="1920" height="1080" color="0x0E0E10FF">
      <Label
        translation="[860, 520]"
        font="font:MediumSystemFont"
        text="Resolving stream..."
        color="0xFFFFFFFF"
        horizAlign="center"
      />
    </Rectangle>
    <Rectangle id="errorBox" width="1920" height="1080" color="0x0E0E10FF" visible="false">
      <Label
        id="errorLabel"
        translation="[460, 480]"
        width="1000"
        font="font:MediumSystemFont"
        text=""
        color="0xFFFFFFFF"
        horizAlign="center"
        wrap="true"
      />
      <Button
        id="retryBtn"
        translation="[800, 620]"
        width="320"
        height="60"
        text="Retry"
      />
    </Rectangle>
  </children>
  <script type="text/brightscript" uri="pkg:/components/ResolveView.brs" />
</component>