<?xml version="1.0" encoding="UTF-8"?>
<component name="MainScene" extends="Scene">
  <children>
    <Rectangle
      id="bg"
      width="1920"
      height="1080"
      color="0x0E0E10FF"
      />
    <PosterGrid
      id="grid"
      translation="[80, 100]"
      basePosterSize="[176,264]"
      itemSpacing="[16,16]"
      numColumns="9"
      numRows="3"
      itemComponentName="GridItem"
      />
    <Group id="detail" visible="false">
      <Poster
        id="backdrop"
        width="1920"
        height="1080"
        loadDisplayMode="scaleToZoom"
        />
      <Rectangle
        id="detailScrimLeft"
        width="1100"
        height="1080"
        color="0x00000080"
      />
      <Label
        id="title"
        translation="[100,180]"
        width="1500"
        font="font:LargeBoldSystemFont"
        color="0xFFFFFFFF"
        />
      <Label
        id="meta"
        translation="[100,280]"
        width="1500"
        font="font:MediumSystemFont"
        color="0xDDDDDDFF"
        />
      <Label
        id="genres"
        translation="[100,320]"
        width="1500"
        font="font:SmallSystemFont"
        color="0xAAAAAAFF"
        />
      <Label
        id="overview"
        translation="[100,380]"
        width="900"
        font="font:SmallSystemFont"
        wrap="true"
        numLines="8"
        color="0xE0E0E0FF"
        />
      <Group
        id="play"
        translation="[100, 760]"
        focusable="true"
        >
        <Rectangle id="bg" width="320" height="88" color="0x808080FF" />
        <Label
          id="text"
          translation="[0, 28]"
          width="320"
          font="font:MediumBoldSystemFont"
          text="Play"
          color="0xFFFFFFFF"
          horizAlign="center"
          />
      </Group>
    </Group>
    <Group id="playerWrap" visible="false">
      <Video
        id="player"
        width="1920"
        height="1080"
        notificationInterval="10"
        />
    </Group>
    <Group id="hud">
      <Rectangle
        id="header"
        width="1920"
        height="72"
        color="0x000000C0"
        />
      <Label
        id="headerTitle"
        translation="[80, 18]"
        font="font:LargeBoldSystemFont"
        text="Watch"
        color="0xFFFFFFFF"
        />
      <Label
        id="headerCount"
        translation="[220, 34]"
        font="font:SmallSystemFont"
        color="0x999999FF"
        />
    </Group>
    <Label
      id="status"
      translation="[960, 540]"
      width="1800"
      font="font:MediumSystemFont"
      text=""
      color="0xFF6060FF"
      horizAlign="center"
      wrap="true"
      />
  </children>
  <script type="text/brightscript" uri="pkg:/source/MainScene.brs" />
</component>
